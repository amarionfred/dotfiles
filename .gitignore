# Only the public desktop/editor profile belongs in this repository.
/*
!/.gitignore
!/README.md
!/install.sh
!/install-files.txt
!/.zshrc
!/.tmux.conf
!/.config/
/.config/*
!/.config/starship.toml
!/.config/cava/
!/.config/fastfetch/
!/.config/fontconfig/
!/.config/gtk-3.0/
!/.config/hypr/
!/.config/kitty/
!/.config/mako/
!/.config/nvim/
!/.config/rofi/
!/.config/tmux/
!/.config/waybar/
!/.config/wofi/
!/.config/autostart/
!/.config/btop/
!/.config/systemd/
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/save-screenshot
!/scripts/
/scripts/*
!/scripts/install.py

# Private editor additions and generated files stay local.
.config/nvim/lua/user/ai.lua
.config/nvim/tools/
.config/nvim/.git/
.config/nvim/.lazy.lua
.config/nvim/.luarc.json
**/.env
**/.env.*
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/node_modules/
**/*.log
**/*.tmp
**/*.bak
**/*.swp
**/*.swo
